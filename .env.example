PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info
APP_ENV=development

# Mixed into every key verifier. Required in production; rotate deliberately,
# because rotating invalidates every key derived with the previous value.
AUTH_PEPPER=dev-pepper-change-me

# How long a credential may be served from cache. 0 disables the cache.
AUTH_CACHE_TTL_SECS=30

# HTTP control plane. Leave ADMIN_TOKENS unset to disable the listener.
# Each entry is name:token[:scope+scope]. The name is the audit actor; no
# scopes means full admin. Scopes: tenants:write, keys:read, keys:write,
# config:read, config:write, audit:read.
# ADMIN_TOKENS=alice:replace-with-a-long-random-token:config:read+keys:read,bob:another-long-token
ADMIN_BIND=127.0.0.1:9090
ADMIN_TIMEOUT_SECS=10
# Audit rows older than this are deleted every 6h. 0 keeps them forever.
AUDIT_RETENTION_DAYS=90

# Development-only: seeds a key on boot. Never set in production.
DEV_API_KEY_SECRET=your-local-secret
DEV_API_KEY_SCOPES=read

# Comma-separated host allowlist for upstreams. Required in production.
# UPSTREAM_ALLOW_HOSTS=swapi.dev,mcp.internal
# What an allowlisted host may resolve to: `deny-link-local` blocks loopback,
# link-local and the metadata service while allowing VPC addresses;
# `deny-private` allows public unicast only; `allow-all` filters nothing.
# The example keeps the safe default. Running the MCP stub on 127.0.0.1 from
# the host is the one development case that needs `allow-all` — set it in your
# local .env, not here.
UPSTREAM_EGRESS=deny-link-local
ROUTE_REFRESH_INTERVAL_MS=2000
# Idle connections kept per upstream client, per replica. Bounds fan-out: N
# replicas holding unbounded idle sockets is how an upstream runs out of
# connections. "Per client" matters — routes that differ in timeout or
# audience get their own client, and each keeps its own up-to-64. Peak
# concurrency is separate and is not capped by this.
UPSTREAM_POOL_MAX_IDLE_PER_HOST=64
# How long a tool schema learned from `tools/list` is trusted. Argument
# validation checks that `arguments` is an object and that every advertised
# `required` field is present; 0 disables it.
MCP_TOOL_SCHEMA_TTL_SECS=300
# Largest tools/list body buffered to filter it. Filtering parses the whole
# catalogue, and a parsed Value costs several times the raw bytes, so this
# bounds memory rather than bandwidth. Raise it for a large catalogue.
MCP_FILTER_MAX_BYTES=1048576
# In-flight requests allowed to one upstream, per replica. 0 disables the
# bulkhead. A bound that rejects traffic is opt-in: the pool bound above only
# decides what is kept, this one decides what is refused. Set it from the
# upstream's own concurrency limit divided by replicas.
UPSTREAM_MAX_CONCURRENCY=0
# How long a request waits for a permit before a 503 + Retry-After. 0 sheds
# immediately, which is the right default for a gateway in front of a slow
# upstream: queueing turns a latency problem into a timeout problem.
UPSTREAM_QUEUE_TIMEOUT_MS=0

MAX_REQUEST_BODY_BYTES=1048576
# Default deadline for a proxied route, and the absolute cap a route may set.
REQUEST_TIMEOUT_SECS=15
MAX_REQUEST_TIMEOUT_SECS=300
# Default response cap; a route may set a lower/higher value or 0 for
# unlimited (use that for long-lived MCP event streams).
MAX_RESPONSE_BYTES=10485760
# A streamed response that produces no bytes for this long is cut.
STREAM_IDLE_TIMEOUT_SECS=60
SHUTDOWN_DRAIN_SECS=25
# Bounds a client that trickles headers, and the total open sockets.
HEADER_READ_TIMEOUT_SECS=10
MAX_CONNECTIONS=1024
# Proxies allowed to speak for the client via X-Forwarded-For / X-Real-IP.
# Empty means the direct peer is always the client (safe default).
# TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8

# Browser origins allowed to call the gateway. Exact origins only; empty
# disables CORS. Server-to-server connectors do not send Origin.
# CORS_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai

# Per replica. Set to 0 to disable a limiter. Per-user is the meaningful unit
# for assistant traffic; per-IP is pre-auth abuse control.
RATE_LIMIT_BACKEND=local
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_TENANT_PER_MINUTE=6000
RATE_LIMIT_USER_PER_MINUTE=600
# Tool calls per minute per tenant per tool. 0 disables. Only enforced on
# routes with a tool policy.
RATE_LIMIT_TOOL_PER_MINUTE=0
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECS=30

# Idempotent retries with a budget. RETRY_MAX_ATTEMPTS=1 disables them.
# Tool calls are POSTs with bodies and are never retried.
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_MS=50
RETRY_BUDGET_RATIO=0.2

# Per-call audit of the data plane. Events are batched off the request path;
# a full queue drops and increments a metric.
DATA_AUDIT_ENABLED=true
DATA_AUDIT_QUEUE_CAPACITY=1024
DATA_AUDIT_BATCH_SIZE=100
DATA_AUDIT_RETENTION_DAYS=90
# Token claims copied into the data-plane audit for attribution (identifiers
# only). Read from the signed token, never from a header or a model argument.
# AUDIT_CLAIMS=project_id,agent_id

# OAuth 2.1 resource server. Leave OAUTH_ISSUER unset to accept API keys only.
# The gateway validates tokens; it never issues them. Use the customer's IdP.
# OAUTH_ISSUER=https://login.example.com
# OAUTH_AUDIENCE=https://gateway.example.com/mcp
# OAUTH_JWKS_URI=https://login.example.com/.well-known/jwks.json
# OAUTH_RESOURCE=https://gateway.example.com/mcp
# OAUTH_AUTHORIZATION_SERVERS=https://login.example.com
# OAUTH_SCOPES_SUPPORTED=mcp:tools
# OAUTH_ALGORITHMS=RS256
# OAUTH_TOKEN_FORMAT=jwt
# OAUTH_CLOCK_SKEW_SECS=30
# OAUTH_JWKS_TTL_SECS=300
# Tenant for tokens without a tenant claim. Must match tenant-bound routes,
# or use a `tenant` claim in the token.
# OAUTH_DEFAULT_TENANT=oauth

# RFC 8693 token exchange. Required for any upstream with an audience.
# OAUTH_TOKEN_ENDPOINT=https://login.example.com/oauth/token
# OAUTH_CLIENT_ID=api-gateway
# OAUTH_CLIENT_SECRET=replace-with-the-idp-client-secret
# basic (default) or post
# OAUTH_CLIENT_AUTH=basic

# OTLP is disabled when unset; logs only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Require a bearer token on /metrics when set.
# METRICS_TOKEN=replace-with-a-metrics-scrape-token

POSTGRES_DB=api_gateway
POSTGRES_USER=api_gateway
POSTGRES_PASSWORD=replace-with-a-local-password
# Host port for the compose database, and the URL host tools use to reach it.
# Change both together if 5432 is already taken on your machine.
DB_HOST_PORT=5432
DATABASE_URL=postgres://api_gateway:replace-with-a-local-password@127.0.0.1:5432/api_gateway
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
