PORT=8080
HOST=127.0.0.1
LOG_LEVEL=debug
APP_ENV=development

# Development-only: seeded API key. Never set in production.
DEV_API_KEY_SECRET=your-local-secret

# Upstream under test (SWAPI is a fixture while the route table is built).
UPSTREAM_BASE_URL=https://swapi.dev/api
UPSTREAM_TIMEOUT_SECS=10
# Required in production; comma-separated host allowlist.
# UPSTREAM_ALLOW_HOSTS=swapi.dev

MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECS=15
SHUTDOWN_DRAIN_SECS=25

# OTLP is disabled when unset; logs only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

POSTGRES_DB=api_gateway
POSTGRES_USER=api_gateway
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://api_gateway:replace-with-a-local-password@127.0.0.1:5432/api_gateway
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
