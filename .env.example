PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info
APP_ENV=development

# Mixed into every key verifier. Required in production; rotate deliberately,
# because rotating invalidates every key derived with the previous value.
AUTH_PEPPER=dev-pepper-change-me

# How long a credential may be served from cache. 0 disables the cache.
AUTH_CACHE_TTL_SECS=30

# HTTP control plane. Leave ADMIN_TOKENS unset to disable the listener.
# Each entry is name:token[:scope+scope]. The name is the audit actor; no
# scopes means full admin. Scopes: tenants:write, keys:read, keys:write,
# config:read, config:write, audit:read.
# ADMIN_TOKENS=alice:replace-with-a-long-random-token:config:read+keys:read,bob:another-long-token
ADMIN_BIND=127.0.0.1:9090

# Development-only: seeds a key on boot. Never set in production.
DEV_API_KEY_SECRET=your-local-secret
DEV_API_KEY_SCOPES=read

# Comma-separated host allowlist for upstreams. Required in production.
# UPSTREAM_ALLOW_HOSTS=swapi.dev
ROUTE_REFRESH_INTERVAL_MS=2000

MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECS=15
SHUTDOWN_DRAIN_SECS=25

# Per replica. Set to 0 to disable a limiter.
RATE_LIMIT_BACKEND=local
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_TENANT_PER_MINUTE=6000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECS=30

# Idempotent retries with a budget. RETRY_MAX_ATTEMPTS=1 disables them.
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_MS=50
RETRY_BUDGET_RATIO=0.2

# OTLP is disabled when unset; logs only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Require a bearer token on /metrics when set.
# METRICS_TOKEN=replace-with-a-metrics-scrape-token

POSTGRES_DB=api_gateway
POSTGRES_USER=api_gateway
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://api_gateway:replace-with-a-local-password@127.0.0.1:5432/api_gateway
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
